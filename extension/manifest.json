{
  "manifest_version": 3,
  "name": "LinkBypassor - LinkShortX Auto Bypass",
  "version": "1.0.0",
  "description": "Automatically walks LinkShortX verification steps and lands you on the final Telegram link. Runs on your own internet, so no block pages.",
  "author": "Ozegbe Mike Isioma",
  "homepage_url": "https://linkbypassor.onrender.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkBypassor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://linkshortx.in/*",
    "*://www.linkshortx.in/*",
    "*://hindisink.com/*",
    "https://linkbypassor.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://linkshortx.in/*",
        "*://www.linkshortx.in/*",
        "*://hindisink.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
